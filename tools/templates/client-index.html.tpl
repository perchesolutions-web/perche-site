<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Instant Fence Quote · {{NAME}}</title>
<meta name="description" content="See the price of a new fence in about a minute. Search your address, trace the fence on satellite imagery, and compare styles from {{NAME}}.">
<meta name="robots" content="noindex">
<link rel="icon" href="{{ICON}}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap">
<link rel="stylesheet" href="/assets/tq.css">
{{POSTHOG}}
</head>
<body>
<!-- Generated by tools/new-client.mjs from clients/{{ID}}.json. Edit the JSON and regenerate instead of editing this file. -->
<div class="cq">
  {{SAMPLE_BANNER}}
  <header class="cq-bar">
    <div class="wrap">
      <a class="cq-name" href="{{HOME_URL}}">{{BRAND_HTML}}</a>
      {{CALL_HTML}}
    </div>
  </header>

  <main class="cq-main">
    <div class="wrap">
      <div class="cq-intro">
        <h1>Get your fence price <em>in about a minute</em></h1>
        <p>Search your address, tap where the fence goes on the satellite photo, and compare styles and prices. No sign-up needed to see your price.</p>
      </div>
      <div id="quote" role="region" aria-label="Instant fence quote"></div>
    </div>
  </main>

  <footer class="cq-foot">
    <div class="wrap">
      <span>© {{YEAR}} {{NAME}}</span>
      <nav aria-label="Legal">
        <a href="privacy.html" target="_blank" rel="noopener">Privacy policy</a>
        <a href="sms-terms.html" target="_blank" rel="noopener">Texting terms</a>
        <span>Quote tool by TraceQuote</span>
      </nav>
    </div>
  </footer>
</div>

<!-- Netlify stores each quote request in this form. Field names must match the quote tool's lead fields. -->
<form name="lead-{{ID}}" method="POST" data-netlify="true" netlify-honeypot="bot-field" hidden>
{{FORM_FIELDS}}
</form>

<script src="/assets/tq-config.js"></script>
<script src="client.js"></script>
<script src="/assets/tq-widget.js"></script>
<script src="/assets/tq-client.js"></script>
</body>
</html>
